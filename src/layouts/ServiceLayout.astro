---
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  slug: string;
  icon: string;
  tagline: string;
  heroDesc: string;
  features: { title: string; desc: string }[];
  process: { step: string; title: string; desc: string }[];
  faqs: { q: string; a: string }[];
  related: { slug: string; label: string; icon: string }[];
}
const { title, description, slug, icon, tagline, heroDesc, features, process, faqs, related } = Astro.props;
---
<Layout title={`${title} | 8dots`} description={description} canonical={`/services/${slug}`}>
  <Navbar />

  <section class="svc-hero">
    <canvas id="svcCanvas"></canvas>
    <div class="container svc-hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/#services">Services</a>
        <span>/</span>
        <span>{title}</span>
      </nav>
      <div class="svc-badge">{icon}</div>
      <h1>{tagline}</h1>
      <p class="svc-hero-desc">{heroDesc}</p>
      <div class="svc-ctas">
        <a href="/#contact" class="btn btn-white">Start a Project →</a>
        <a href="/#services" class="btn btn-outline">← All Services</a>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="features-section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">What's Included</span>
        <h2 class="section-title">Everything in Our <span class="outline">{title}</span> Service</h2>
      </div>
      <div class="features-grid">
        {features.map((f, i) => (
          <div class="feature-card reveal" style={`--delay:${i * 60}ms`}>
            <div class="fc-num">0{i+1}</div>
            <h3>{f.title}</h3>
            <p>{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="process-section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">How We Work</span>
        <h2 class="section-title">Our <span class="outline">Process</span></h2>
      </div>
      <div class="process-steps">
        {process.map((p, i) => (
          <div class="process-step reveal">
            <div class="ps-step">{p.step}</div>
            <div class="ps-content">
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </div>
            {i < process.length - 1 && <div class="ps-line"></div>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section">
    <div class="container faq-inner">
      <div class="section-header reveal">
        <span class="section-label">FAQ</span>
        <h2 class="section-title">Common <span class="outline">Questions</span></h2>
      </div>
      <div class="faq-list">
        {faqs.map(f => (
          <details class="faq-item reveal">
            <summary class="faq-q">{f.q}<span class="faq-icon">+</span></summary>
            <p class="faq-a">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- RELATED -->
  <section class="related-section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">Also From 8dots</span>
        <h2 class="section-title">Related <span class="outline">Services</span></h2>
      </div>
      <div class="related-grid">
        {related.map(r => (
          <a href={`/services/${r.slug}`} class="related-card reveal">
            <span class="rc-icon">{r.icon}</span>
            <span class="rc-label">{r.label}</span>
            <span class="rc-arr">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="svc-cta-band">
    <div class="container svc-cta-inner reveal">
      <h2>Ready to Start Your<br/><span class="outline-dark">{title}</span> Project?</h2>
      <a href="/#contact" class="btn btn-cta-dark">Get a Free Quote →</a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
/* HERO */
.svc-hero {
  position: relative;
  min-height: 70vh;
  display: flex;
  align-items: flex-end;
  padding-bottom: 80px;
  overflow: hidden;
  background: var(--black);
}
#svcCanvas {
  position: absolute;
  inset: 0;
  width: 100%; height: 100%;
  opacity: 0.6;
}
.svc-hero-inner {
  position: relative;
  z-index: 2;
  padding-top: 140px;
}
.breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: var(--gray);
  margin-bottom: 32px;
  flex-wrap: wrap;
}
.breadcrumb a { color: var(--gray); transition: color 0.2s; }
.breadcrumb a:hover { color: var(--white); }
.breadcrumb span { color: rgba(255,255,255,0.3); }
.breadcrumb span:last-child { color: var(--white); }
.svc-badge {
  font-size: 48px;
  margin-bottom: 16px;
}
.svc-hero-inner h1 {
  font-size: clamp(36px, 6vw, 72px);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -2px;
  margin-bottom: 20px;
}
.svc-hero-desc {
  font-size: 18px;
  color: rgba(255,255,255,0.55);
  max-width: 580px;
  line-height: 1.7;
  margin-bottom: 36px;
}
.svc-ctas { display: flex; gap: 16px; flex-wrap: wrap; }

/* FEATURES */
.features-section { padding: 100px 0; }
.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.06);
}
.feature-card {
  background: var(--black);
  padding: 36px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  transition: background 0.3s;
  transition-delay: var(--delay, 0ms);
}
.feature-card:hover { background: var(--black3); }
.fc-num { font-family: var(--font-display); font-size: 11px; color: var(--gray2); font-weight: 700; letter-spacing: 0.1em; }
.feature-card h3 { font-family: var(--font-display); font-size: 18px; font-weight: 800; }
.feature-card p { font-size: 14px; color: var(--gray); line-height: 1.7; }

/* PROCESS */
.process-section { padding: 100px 0; background: var(--black2); }
.process-steps { display: flex; flex-direction: column; gap: 0; }
.process-step {
  display: grid;
  grid-template-columns: 80px 1fr auto;
  align-items: start;
  gap: 32px;
  padding: 40px 0;
  border-bottom: 1px solid rgba(255,255,255,0.06);
  position: relative;
}
.process-step:last-child { border-bottom: none; }
.ps-step {
  font-family: var(--font-display);
  font-size: 48px;
  font-weight: 800;
  color: rgba(255,255,255,0.08);
  line-height: 1;
}
.ps-content h3 { font-family: var(--font-display); font-size: 22px; font-weight: 800; margin-bottom: 8px; }
.ps-content p { color: var(--gray); font-size: 15px; line-height: 1.7; max-width: 560px; }
.ps-line { display: none; }

/* FAQ */
.faq-section { padding: 100px 0; }
.faq-inner { display: grid; grid-template-columns: 1fr 1.4fr; gap: 80px; }
.faq-list { display: flex; flex-direction: column; }
.faq-item {
  border-bottom: 1px solid rgba(255,255,255,0.06);
  padding: 24px 0;
}
.faq-item:first-child { border-top: 1px solid rgba(255,255,255,0.06); }
.faq-q {
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  font-size: 16px;
  font-weight: 600;
  list-style: none;
  gap: 16px;
}
.faq-q::-webkit-details-marker { display: none; }
.faq-icon { font-size: 24px; color: var(--gray); flex-shrink: 0; transition: transform 0.3s; }
details[open] .faq-icon { transform: rotate(45deg); }
.faq-a { color: var(--gray); font-size: 15px; line-height: 1.7; padding-top: 12px; }

/* RELATED */
.related-section { padding: 80px 0; }
.related-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 16px;
}
.related-card {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 24px;
  background: var(--black2);
  border: 1px solid rgba(255,255,255,0.06);
  text-decoration: none;
  color: inherit;
  transition: all 0.2s;
}
.related-card:hover { border-color: rgba(255,255,255,0.3); background: var(--black3); }
.rc-icon { font-size: 22px; }
.rc-label { font-size: 14px; font-weight: 600; flex: 1; }
.rc-arr { color: var(--gray2); transition: all 0.2s; }
.related-card:hover .rc-arr { color: var(--white); transform: translate(4px, -4px); }

/* CTA */
.svc-cta-band { background: var(--white); padding: 100px 0; }
.svc-cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 40px; flex-wrap: wrap; }
.svc-cta-inner h2 { font-size: clamp(32px, 4vw, 52px); font-weight: 800; line-height: 1.1; color: var(--black); }
.outline-dark { -webkit-text-stroke: 2px var(--black); color: transparent; }
.btn-cta-dark { background: var(--black); color: var(--white); padding: 18px 48px; font-size: 15px; font-family: var(--font); font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; text-decoration: none; transition: all 0.3s; display: inline-flex; align-items: center; }
.btn-cta-dark:hover { background: #222; transform: translateY(-2px); }

/* SHARED */
.section-header { margin-bottom: 56px; }
.section-label { display: inline-flex; align-items: center; gap: 10px; font-size: 11px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gray); margin-bottom: 20px; }
.section-label::before { content: ''; display: block; width: 24px; height: 1px; background: var(--gray); }
.section-title { font-size: clamp(32px, 4vw, 48px); font-weight: 800; line-height: 1.1; margin-bottom: 16px; letter-spacing: -1px; }
.outline { -webkit-text-stroke: 1px var(--white); color: transparent; }
.btn { display: inline-flex; align-items: center; gap: 8px; padding: 14px 32px; font-family: var(--font); font-size: 14px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; cursor: pointer; transition: all 0.3s; border: none; text-decoration: none; }
.btn-white { background: var(--white); color: var(--black); }
.btn-white:hover { background: var(--white2); transform: translateY(-2px); }
.btn-outline { background: transparent; color: var(--white); border: 1px solid rgba(255,255,255,0.3); }
.btn-outline:hover { border-color: var(--white); }

@media (max-width: 900px) {
  .faq-inner { grid-template-columns: 1fr; }
  .svc-cta-inner { flex-direction: column; text-align: center; }
  .process-step { grid-template-columns: 60px 1fr; }
}
@media (max-width: 600px) {
  .process-step { grid-template-columns: 1fr; }
  .ps-step { font-size: 32px; }
}
</style>

<script>
(async () => {
  const canvas = document.getElementById('svcCanvas');
  if (!canvas) return;
  const THREE = await import('https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.module.js');
  const W = canvas.offsetWidth || window.innerWidth, H = canvas.offsetHeight || 500;
  const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
  renderer.setSize(W, H);
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(60, W/H, 0.1, 1000);
  camera.position.z = 20;
  const geo = new THREE.BufferGeometry();
  const count = 1500;
  const pos = new Float32Array(count * 3);
  for (let i = 0; i < count * 3; i++) pos[i] = (Math.random() - 0.5) * 80;
  geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
  const mat = new THREE.PointsMaterial({ color: 0xffffff, size: 0.1, transparent: true, opacity: 0.3 });
  scene.add(new THREE.Points(geo, mat));
  function animate() {
    requestAnimationFrame(animate);
    geo.attributes.position.array.forEach((_, i) => {
      if (i % 3 === 1) geo.attributes.position.array[i] += Math.sin(Date.now() * 0.0005 + i) * 0.002;
    });
    geo.attributes.position.needsUpdate = true;
    renderer.render(scene, camera);
  }
  animate();
})();

document.querySelectorAll('.faq-q').forEach(q => {
  q.addEventListener('click', () => {
    const item = q.closest('details');
    document.querySelectorAll('details[open]').forEach(d => { if (d !== item) d.removeAttribute('open'); });
  });
});
</script>
