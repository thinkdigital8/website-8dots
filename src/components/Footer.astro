---
const services = [
  { slug: 'branding', label: 'Branding' },
  { slug: 'web-development', label: 'Web Development' },
  { slug: 'app-development', label: 'App Development' },
  { slug: 'ui-ux-design', label: 'UI/UX Design' },
  { slug: 'digital-marketing', label: 'Digital Marketing' },
  { slug: 'graphic-design', label: 'Graphic Design' },
  { slug: 'software-development', label: 'Software Development' },
];
---
<footer>
  <div class="footer-top container">
    <div class="footer-brand">
      <a href="/" class="logo">
        <span class="logo-mark">8</span><span>dots</span>
      </a>
      <p>A full-service creative digital agency in Ahmedabad, India. We build brands, products, and experiences that matter.</p>
      <div class="footer-socials">
        <a href="https://linkedin.com/company/8dots" aria-label="LinkedIn" target="_blank" rel="noopener">in</a>
        <a href="https://instagram.com/8dots.in" aria-label="Instagram" target="_blank" rel="noopener">ig</a>
        <a href="https://facebook.com/8dots.in" aria-label="Facebook" target="_blank" rel="noopener">fb</a>
      </div>
    </div>
    <div class="footer-col">
      <h4>Services</h4>
      <ul>
        {services.map(s => <li><a href={`/services/${s.slug}`}>{s.label}</a></li>)}
      </ul>
    </div>
    <div class="footer-col">
      <h4>Company</h4>
      <ul>
        <li><a href="/#about">About</a></li>
        <li><a href="/#work">Work</a></li>
        <li><a href="/#contact">Contact</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Contact</h4>
      <div class="footer-contact">
        <a href="mailto:info@8dots.in">info@8dots.in</a>
        <a href="tel:+917778882276">+91 77788 82276</a>
        <address>516 STC, Bopal,<br>Ahmedabad, Gujarat 380058</address>
        <address>Houston, TX, USA</address>
      </div>
    </div>
  </div>
  <div class="footer-bottom container">
    <p>&copy; {new Date().getFullYear()} 8dots. All rights reserved.</p>
    <p>Crafted with precision in Ahmedabad, India.</p>
  </div>
</footer>

<style>
footer {
  background: #060606;
  border-top: 1px solid rgba(255,255,255,0.06);
  color: rgba(248,248,246,0.6);
}
.footer-top {
  display: grid;
  grid-template-columns: 1.4fr 1fr 0.8fr 1.2fr;
  gap: 3rem;
  padding-top: 5rem;
  padding-bottom: 4rem;
}
.footer-brand .logo {
  display: inline-flex;
  align-items: baseline;
  gap: 0.1rem;
  font-family: 'Syne', sans-serif;
  font-weight: 800;
  font-size: 1.3rem;
  color: #f8f8f6;
  margin-bottom: 1.25rem;
}
.footer-brand .logo-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  background: #f8f8f6;
  color: #0a0a0a;
  border-radius: 50%;
  font-size: 1rem;
}
.footer-brand p {
  font-size: 0.875rem;
  line-height: 1.75;
  max-width: 260px;
  margin-bottom: 1.5rem;
}
.footer-socials {
  display: flex;
  gap: 0.75rem;
}
.footer-socials a {
  width: 36px;
  height: 36px;
  border: 1px solid rgba(255,255,255,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: rgba(248,248,246,0.5);
  transition: border-color 0.2s, color 0.2s;
}
.footer-socials a:hover { border-color: rgba(255,255,255,0.4); color: #f8f8f6; }

.footer-col h4 {
  font-family: 'Syne', sans-serif;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: rgba(248,248,246,0.3);
  margin-bottom: 1.25rem;
}
.footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 0.7rem; }
.footer-col a {
  font-size: 0.9rem;
  color: rgba(248,248,246,0.55);
  transition: color 0.2s;
}
.footer-col a:hover { color: #f8f8f6; }

.footer-contact {
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
}
.footer-contact a, .footer-contact address {
  font-size: 0.9rem;
  color: rgba(248,248,246,0.55);
  font-style: normal;
  line-height: 1.6;
  transition: color 0.2s;
}
.footer-contact a:hover { color: #f8f8f6; }

.footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.05);
  padding-top: 1.5rem;
  padding-bottom: 2rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
}
.footer-bottom p { font-size: 0.8rem; color: rgba(248,248,246,0.25); }

@media (max-width: 900px) {
  .footer-top { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 540px) {
  .footer-top { grid-template-columns: 1fr; gap: 2.5rem; }
  .footer-bottom { flex-direction: column; align-items: flex-start; }
}
</style>
