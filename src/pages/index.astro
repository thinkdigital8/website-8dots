---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const services = [
  { slug: 'branding', icon: '◎', title: 'Branding & Identity', desc: 'Strategic brand systems — positioning, naming, visual identity, and brand voice for businesses that want to stand out.' },
  { slug: 'web-development', icon: '⬡', title: 'Web Design & Development', desc: 'Pixel-perfect, high-performance websites and web apps built with modern technology and obsessive attention to detail.' },
  { slug: 'app-development', icon: '◻', title: 'App Development', desc: 'Native and cross-platform iOS and Android apps — from concept and UX through to App Store launch and beyond.' },
  { slug: 'ui-ux-design', icon: '◈', title: 'UI/UX Design', desc: 'Research-driven interfaces that feel intuitive, look stunning, and convert visitors into loyal customers.' },
  { slug: 'digital-marketing', icon: '◆', title: 'Digital Marketing', desc: 'Data-driven growth across SEO, Google Ads, Meta, social media, and content — every rupee accountable.' },
  { slug: 'graphic-design', icon: '◐', title: 'Graphic Design', desc: 'Visual storytelling — logos, motion graphics, print, and social creatives that make your brand impossible to ignore.' },
  { slug: 'software-development', icon: '◑', title: 'Software Development', desc: 'Custom ERP, CRM, and SaaS platforms engineered to solve complex business problems at scale.' },
];

const work = [
  { title: 'VivaBite', category: 'Food Delivery App', tags: ['App Dev', 'UI/UX'], img: 'https://images.unsplash.com/photo-1551650975-87deedd944c3?w=900&q=80&auto=format&fit=crop', outcome: 'From zero to 50k downloads in 4 months. App Store rating: 4.8★' },
  { title: 'Luxe Naturals', category: 'Brand Identity & Packaging', tags: ['Branding', 'Graphic Design'], img: 'https://images.unsplash.com/photo-1611532736597-de2d4265fba3?w=900&q=80&auto=format&fit=crop', outcome: 'Full rebrand led to 3× revenue growth in first year.' },
  { title: 'TechVault SaaS', category: 'Web Design & Development', tags: ['Web Dev', 'UI/UX'], img: 'https://images.unsplash.com/photo-1467232004584-a241de8bcf5d?w=900&q=80&auto=format&fit=crop', outcome: '120% increase in trial signups after redesign.' },
  { title: 'GrowStar', category: 'Digital Marketing', tags: ['SEO', 'Paid Media'], img: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=900&q=80&auto=format&fit=crop', outcome: '340% organic traffic growth and 50% lower CAC in 6 months.' },
];

const industries = ['Technology', 'Professional Services', 'Healthcare', 'Legal & Compliance', 'Real Estate', 'E-Commerce', 'Startups', 'Education', 'Food & Beverage', 'Finance & Fintech', 'Manufacturing'];

const process = [
  { num: '01', title: 'Discovery', desc: 'We deep-dive into your business, audience, and goals before a single concept is created.' },
  { num: '02', title: 'Strategy', desc: 'A clear, focused plan — positioning, architecture, and creative direction locked in.' },
  { num: '03', title: 'Design & Build', desc: 'Agile execution with regular check-ins, demos, and full transparency throughout.' },
  { num: '04', title: 'Launch & Grow', desc: 'Smooth delivery and ongoing support — we measure outcomes, not just outputs.' },
];

const testimonials = [
  { name: 'Ravi Mehta', role: 'CEO, NovaTech Solutions', img: 'https://images.unsplash.com/photo-1560250097-0b93528c311a?w=120&q=80&auto=format&fit=crop&crop=face', text: '8dots transformed our brand identity from the ground up. The strategy was sharp, the design was stunning, and the investor response was immediate. Best decision we made.' },
  { name: 'Priya Sharma', role: 'Founder, UrbanEats', img: 'https://images.unsplash.com/photo-1580489944761-15a19d654956?w=120&q=80&auto=format&fit=crop&crop=face', text: 'The app they built has 4.9 stars after 1,200+ reviews. That\'s not luck — that\'s meticulous design and engineering. We went from idea to launch in 16 weeks.' },
  { name: 'Amit Joshi', role: 'CMO, FinServe India', img: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=120&q=80&auto=format&fit=crop&crop=face', text: 'Our organic traffic grew 340% in 6 months and our paid CAC dropped by half. 8dots builds growth systems, not just campaigns. Exceptional ROI.' },
];

const team = [
  { name: 'Snehal Patel', role: 'Founder & Creative Director', img: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=400&q=80&auto=format&fit=crop&crop=face' },
  { name: 'Tushar Premal', role: 'Co-Founder & Tech Lead', img: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=400&q=80&auto=format&fit=crop&crop=face' },
  { name: 'Arbaz Shaikh', role: 'Head of Design', img: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&q=80&auto=format&fit=crop&crop=face' },
  { name: 'Aradhana Yadav', role: 'Digital Marketing Lead', img: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=400&q=80&auto=format&fit=crop&crop=face' },
  { name: 'Arjun Odedara', role: 'Full Stack Developer', img: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=400&q=80&auto=format&fit=crop&crop=face' },
];

const faqs = [
  { q: 'How long does a typical project take?', a: 'Timelines vary by scope. A brand identity takes 6–10 weeks. A website is 4–8 weeks. An app is typically 12–20 weeks. We\'ll give you a precise timeline in your proposal.' },
  { q: 'What is your pricing structure?', a: 'We work on project-based pricing tailored to your scope, not hourly rates. Projects start from ₹1.5L for focused deliverables. Comprehensive engagements range from ₹5L–₹25L+. Contact us for a detailed quote.' },
  { q: 'Do you work with international clients?', a: 'Yes. We have clients in India, USA, UK, UAE, and Singapore. We work asynchronously across time zones and use tools like Figma, Notion, and Loom to keep communication clear.' },
  { q: 'What happens after the project launches?', a: 'We offer retainer-based maintenance and growth packages. Most clients stay with us for ongoing work — we\'re a long-term partner, not a one-off vendor.' },
  { q: 'How do you handle revisions?', a: 'Every project includes defined revision rounds (typically 2–3 per phase). We use structured feedback processes so revisions are focused and efficient, not endless back-and-forth.' },
];
---

<Layout title="8dots — Ahmedabad's Premier Digital Agency | Branding, Web & App Development" description="8dots is a full-service creative digital agency in Ahmedabad. We help ambitious businesses grow through strategic branding, web development, app development, and digital marketing.">
  <Navbar />

  <!-- ═══ HERO ═══ -->
  <section class="hero">
    <div class="hero-content container">
      <div class="hero-left">
        <div class="hero-badge reveal">
          <span class="badge-dot"></span>
          Ahmedabad's Award-Winning Digital Agency
        </div>
        <h1 class="hero-h1 reveal reveal-delay-1">
          We Create Digital<br>
          Experiences That<br>
          <span class="outline-dark">Drive Growth.</span>
        </h1>
        <p class="hero-sub reveal reveal-delay-2">
          Strategy, branding, design, and technology — all under one roof.<br>
          Trusted by 50+ businesses across India and beyond.
        </p>
        <div class="hero-ctas reveal reveal-delay-3">
          <a href="/#contact" class="btn btn-black">Request a Proposal</a>
          <a href="/#work" class="btn btn-outline">Explore Our Work</a>
        </div>
        <div class="hero-ratings reveal reveal-delay-4">
          <div class="rating-item">
            <div class="stars">★★★★★</div>
            <span>5.0 on Clutch</span>
          </div>
          <div class="rating-divider"></div>
          <div class="rating-item">
            <div class="stars">★★★★★</div>
            <span>50+ Verified Reviews</span>
          </div>
          <div class="rating-divider"></div>
          <div class="rating-item">
            <strong>13+</strong>
            <span>Years of Excellence</span>
          </div>
        </div>
      </div>
      <div class="hero-visuals reveal reveal-delay-2">
        <div class="hero-img-grid">
          <div class="himg himg-1">
            <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=600&q=85&auto=format&fit=crop" alt="8dots team" loading="eager" />
          </div>
          <div class="himg himg-2">
            <img src="https://images.unsplash.com/photo-1561070791-2526d30994b5?w=500&q=85&auto=format&fit=crop" alt="Design work" loading="eager" />
          </div>
          <div class="himg himg-3">
            <img src="https://images.unsplash.com/photo-1551650975-87deedd944c3?w=500&q=85&auto=format&fit=crop" alt="App mockup" loading="eager" />
          </div>
        </div>
        <div class="hero-float-card">
          <div class="float-icon">📈</div>
          <div>
            <strong>+340%</strong>
            <p>Avg organic growth for clients</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ TRUST STRIP ═══ -->
  <div class="trust-strip section-light">
    <div class="container">
      <div class="trust-inner">
        <span class="trust-label">Trusted by businesses across</span>
        <div class="trust-stats">
          <div class="tstat"><strong>200+</strong><span>Projects Delivered</span></div>
          <div class="tstat-div"></div>
          <div class="tstat"><strong>50+</strong><span>Happy Clients</span></div>
          <div class="tstat-div"></div>
          <div class="tstat"><strong>13+</strong><span>Years Experience</span></div>
          <div class="tstat-div"></div>
          <div class="tstat"><strong>7</strong><span>Core Services</span></div>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ SERVICES ═══ -->
  <section class="section" id="services">
    <div class="container">
      <div class="services-header reveal">
        <div class="section-head">
          <span class="eyebrow">Our Services</span>
          <h2>Everything your brand<br>needs to grow.</h2>
          <p>Seven specialisms, one team. We handle every dimension of your digital presence — from first strategy session to post-launch growth.</p>
        </div>
        <a href="/#contact" class="btn btn-outline">View All Services</a>
      </div>
      <div class="services-grid">
        {services.map((s, i) => (
          <a href={`/services/${s.slug}`} class={`svc-card reveal reveal-delay-${(i % 4) + 1}`}>
            <div class="svc-card-top">
              <span class="svc-icon">{s.icon}</span>
              <span class="svc-num">0{i + 1}</span>
            </div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <span class="svc-link">Learn more <span class="arrow">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ WORK / CASE STUDIES ═══ -->
  <section class="section section-light" id="work">
    <div class="container">
      <div class="work-header reveal">
        <div class="section-head">
          <span class="eyebrow">Our Work</span>
          <h2>Projects we're proud of.</h2>
          <p>A selection of recent work across branding, web, apps, and marketing.</p>
        </div>
        <a href="/#contact" class="btn btn-black">Start Your Project</a>
      </div>
      <div class="work-grid">
        {work.map((w, i) => (
          <div class={`work-card reveal reveal-delay-${(i % 3) + 1}`}>
            <div class="work-img">
              <img src={w.img} alt={w.title} loading="lazy" />
              <div class="work-tags">
                {w.tags.map(t => <span>{t}</span>)}
              </div>
            </div>
            <div class="work-body">
              <span class="work-cat">{w.category}</span>
              <h3>{w.title}</h3>
              <p class="work-outcome">{w.outcome}</p>
              <span class="work-cta">Read Case Study →</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ PROCESS ═══ -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">How We Work</span>
        <h2>A process built for<br>results, not egos.</h2>
      </div>
      <div class="process-grid">
        {process.map((p, i) => (
          <div class={`process-card reveal reveal-delay-${i + 1}`}>
            <span class="process-num">{p.num}</span>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ INDUSTRIES ═══ -->
  <section class="section section-dark">
    <div class="container">
      <div class="section-head reveal" style="color:#f0ede8">
        <span class="eyebrow" style="color:#888">Industries We Serve</span>
        <h2>We've worked across<br>11 industries and counting.</h2>
        <p style="color:#888">Deep sector expertise means we speak your language from day one.</p>
      </div>
      <div class="industries-grid">
        {industries.map((ind, i) => (
          <div class={`industry-tag reveal reveal-delay-${(i % 4) + 1}`}>
            <span>{ind}</span>
            <span class="ind-arrow">↗</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ ABOUT / TEAM ═══ -->
  <section class="section" id="about">
    <div class="container">
      <div class="about-grid">
        <div class="about-left reveal">
          <span class="eyebrow">About 8dots</span>
          <h2>A team of makers,<br>thinkers & builders<br>in Ahmedabad.</h2>
          <p>Founded in 2012, we've spent 13+ years helping businesses grow through smart strategy and exceptional craft. We're a tight team of designers, developers, and strategists — no bloated agency structures, just great people doing great work.</p>
          <div class="about-highlights">
            <div class="highlight"><strong>India & USA</strong><span>Two offices, global reach</span></div>
            <div class="highlight"><strong>48-hour</strong><span>Average response time SLA</span></div>
            <div class="highlight"><strong>96%</strong><span>Client satisfaction rate</span></div>
          </div>
        </div>
        <div class="team-grid reveal reveal-delay-2">
          {team.map((m) => (
            <div class="team-card">
              <div class="team-img">
                <img src={m.img} alt={m.name} loading="lazy" />
              </div>
              <h4>{m.name}</h4>
              <p>{m.role}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ TESTIMONIALS ═══ -->
  <section class="section section-light">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Client Stories</span>
        <h2>Don't take our word for it.</h2>
      </div>
      <div class="testi-grid">
        {testimonials.map((t, i) => (
          <div class={`testi-card reveal reveal-delay-${i + 1}`}>
            <div class="testi-stars">★★★★★</div>
            <p class="testi-quote">&ldquo;{t.text}&rdquo;</p>
            <div class="testi-author">
              <img src={t.img} alt={t.name} loading="lazy" />
              <div>
                <strong>{t.name}</strong>
                <span>{t.role}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FAQ ═══ -->
  <section class="section">
    <div class="container">
      <div class="faq-layout">
        <div class="faq-left reveal">
          <span class="eyebrow">FAQ</span>
          <h2>Answers to the<br>questions we hear<br>most often.</h2>
          <p>Still have a question? <a href="/#contact" style="text-decoration:underline">Drop us a message →</a></p>
          <div class="faq-cta-block">
            <a href="/#contact" class="btn btn-black" style="margin-top:2rem">Start a Conversation</a>
          </div>
        </div>
        <div class="faq-list reveal reveal-delay-2">
          {faqs.map((f, i) => (
            <details class={`faq-item ${i === 0 ? 'open-default' : ''}`}>
              <summary>{f.q}</summary>
              <div class="faq-answer">{f.a}</div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ CTA BAND ═══ -->
  <section class="cta-band section-dark">
    <div class="container">
      <div class="cta-inner reveal">
        <div class="cta-text">
          <span class="eyebrow" style="color:#555">Let's Build Something</span>
          <h2>Ready to make your<br>brand <span class="outline">unforgettable?</span></h2>
        </div>
        <div class="cta-actions">
          <a href="/#contact" class="btn btn-white">Request a Proposal</a>
          <a href="tel:+917778882276" class="btn btn-white-outline">+91 77788 82276</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ CONTACT ═══ -->
  <section class="section" id="contact">
    <div class="container">
      <div class="contact-layout">
        <div class="contact-left reveal">
          <span class="eyebrow">Get In Touch</span>
          <h2>Let's start a<br>conversation.</h2>
          <p>Tell us about your project. We'll respond within 24 hours with a plan and next steps.</p>
          <div class="contact-info">
            <div class="cinfo-item">
              <span class="cinfo-label">Email</span>
              <a href="mailto:info@8dots.in">info@8dots.in</a>
            </div>
            <div class="cinfo-item">
              <span class="cinfo-label">Phone</span>
              <a href="tel:+917778882276">+91 77788 82276</a>
            </div>
            <div class="cinfo-item">
              <span class="cinfo-label">Ahmedabad</span>
              <address>516 STC, Bopal, Ahmedabad,<br>Gujarat 380058, India</address>
            </div>
            <div class="cinfo-item">
              <span class="cinfo-label">USA</span>
              <address>Houston, TX, USA</address>
            </div>
          </div>
        </div>
        <form class="contact-form reveal reveal-delay-2" name="contact" method="POST" data-netlify="true">
          <input type="hidden" name="form-name" value="contact" />
          <div class="form-row">
            <div class="form-field">
              <label>Full Name <span>*</span></label>
              <input type="text" name="name" placeholder="Your name" required />
            </div>
            <div class="form-field">
              <label>Email Address <span>*</span></label>
              <input type="email" name="email" placeholder="you@company.com" required />
            </div>
          </div>
          <div class="form-field">
            <label>Service You Need</label>
            <select name="service">
              <option value="">Select a service…</option>
              <option>Branding & Identity</option>
              <option>Web Design & Development</option>
              <option>App Development</option>
              <option>UI/UX Design</option>
              <option>Digital Marketing</option>
              <option>Graphic Design</option>
              <option>Software Development</option>
              <option>Multiple / Not Sure</option>
            </select>
          </div>
          <div class="form-field">
            <label>Project Budget</label>
            <select name="budget">
              <option value="">Select a range…</option>
              <option>Under ₹1L</option>
              <option>₹1L – ₹3L</option>
              <option>₹3L – ₹10L</option>
              <option>₹10L – ₹25L</option>
              <option>₹25L+</option>
            </select>
          </div>
          <div class="form-field">
            <label>Tell us about your project <span>*</span></label>
            <textarea name="message" rows="5" placeholder="What are you looking to build? What's your timeline?" required></textarea>
          </div>
          <button type="submit" class="btn btn-black" style="width:100%;justify-content:center;padding:1rem">
            Send Message →
          </button>
        </form>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
/* ─── HERO ─── */
.hero {
  padding-top: 72px;
  background: var(--white);
}
.hero-content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: center;
  padding-top: clamp(3rem, 7vw, 6rem);
  padding-bottom: clamp(3rem, 7vw, 6rem);
}
.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted);
  background: var(--off-white);
  border: 1px solid var(--border);
  padding: 0.45rem 0.9rem;
  border-radius: 100px;
  margin-bottom: 1.75rem;
}
.badge-dot {
  width: 6px;
  height: 6px;
  background: #22c55e;
  border-radius: 50%;
  flex-shrink: 0;
}
.hero-h1 {
  font-family: 'Syne', sans-serif;
  font-size: clamp(2.5rem, 5vw, 5rem);
  font-weight: 800;
  line-height: 0.98;
  letter-spacing: -0.03em;
  color: var(--text);
  margin-bottom: 1.5rem;
}
.hero-sub {
  font-size: 1.05rem;
  color: var(--muted);
  line-height: 1.75;
  margin-bottom: 2.5rem;
}
.hero-ctas { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 3rem; }
.hero-ratings {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  flex-wrap: wrap;
}
.rating-item {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}
.rating-item .stars { color: #f59e0b; font-size: 0.85rem; letter-spacing: 0.05em; }
.rating-item span { font-size: 0.72rem; color: var(--muted); }
.rating-item strong { font-size: 1.4rem; font-family: 'Syne', sans-serif; font-weight: 800; line-height: 1; }
.rating-divider { width: 1px; height: 32px; background: var(--border); flex-shrink: 0; }

/* Hero visuals */
.hero-visuals { position: relative; }
.hero-img-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 260px 200px;
  gap: 12px;
  border-radius: 8px;
  overflow: hidden;
}
.himg { overflow: hidden; }
.himg img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s; }
.himg:hover img { transform: scale(1.04); }
.himg-1 { grid-row: 1 / 3; }
.himg-2 { }
.himg-3 { }
.hero-float-card {
  position: absolute;
  bottom: -20px;
  left: -24px;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  background: var(--white);
  border: 1px solid var(--border);
  box-shadow: 0 8px 32px rgba(0,0,0,0.1);
  padding: 0.875rem 1.25rem;
  border-radius: 8px;
}
.float-icon { font-size: 1.5rem; }
.hero-float-card strong { display: block; font-size: 1.3rem; font-family: 'Syne', sans-serif; font-weight: 800; line-height: 1; }
.hero-float-card p { font-size: 0.75rem; color: var(--muted); margin-top: 0.15rem; }

/* ─── TRUST STRIP ─── */
.trust-strip { padding: 2rem 0; }
.trust-inner {
  display: flex;
  align-items: center;
  gap: 3rem;
  flex-wrap: wrap;
}
.trust-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted); flex-shrink: 0; }
.trust-stats { display: flex; align-items: center; gap: 2rem; flex-wrap: wrap; }
.tstat { display: flex; flex-direction: column; }
.tstat strong { font-size: 1.5rem; font-family: 'Syne', sans-serif; font-weight: 800; color: var(--text); line-height: 1; }
.tstat span { font-size: 0.72rem; color: var(--muted); margin-top: 0.15rem; }
.tstat-div { width: 1px; height: 32px; background: var(--border); }

/* ─── SERVICES ─── */
