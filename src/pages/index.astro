<script>
document.querySelectorAll('.faq-item').forEach((item, i) => {
  if (i === 0) item.setAttribute('open', '');
  item.addEventListener('click', e => {
    if ((e.target as HTMLElement).tagName === 'SUMMARY' || (e.target as HTMLElement).closest('summary')) {
      const isOpen = item.hasAttribute('open');
      document.querySelectorAll('.faq-item[open]').forEach(d => d.removeAttribute('open'));
      if (!isOpen) setTimeout(() => item.setAttribute('open', ''), 0);
    }
  });
});
</script>
