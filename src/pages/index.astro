---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const services = [
  { slug: 'branding', icon: '💡', title: 'Branding', desc: 'Strategic brand identity — positioning, naming, and visual systems for brands people choose.', img: 'https://images.unsplash.com/photo-1434030216411-0b793f4b4173?w=600&q=80&auto=format&fit=crop' },
  { slug: 'web-development', icon: '🌐', title: 'Web Development', desc: 'Pixel-perfect, blazing-fast websites built with modern stacks and obsessive attention to detail.', img: 'https://images.unsplash.com/photo-1467232004584-a241de8bcf5d?w=600&q=80&auto=format&fit=crop' },
  { slug: 'app-development', icon: '📱', title: 'App Development', desc: 'iOS and Android apps that users love — from concept to App Store launch.', img: 'https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?w=600&q=80&auto=format&fit=crop' },
  { slug: 'ui-ux-design', icon: '🎨', title: 'UI/UX Design', desc: 'Interfaces that feel intuitive, look stunning, and drive measurable results.', img: 'https://images.unsplash.com/photo-1561070791-2526d30994b5?w=600&q=80&auto=format&fit=crop' },
  { slug: 'digital-marketing', icon: '📈', title: 'Digital Marketing', desc: 'Data-driven growth across SEO, paid ads, social media, and content strategy.', img: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=600&q=80&auto=format&fit=crop' },
  { slug: 'graphic-design', icon: '✏️', title: 'Graphic Design', desc: 'Visual stories that stop the scroll — logos, motion graphics, and print that stand out.', img: 'https://images.unsplash.com/photo-1558655146-9f40138edfeb?w=600&q=80&auto=format&fit=crop' },
  { slug: 'software-development', icon: '⚙️', title: 'Software Dev', desc: 'Custom SaaS, ERP, and enterprise software engineered for complex, real-world problems.', img: 'https://images.unsplash.com/photo-1504639725590-34d0984388bd?w=600&q=80&auto=format&fit=crop' },
];

const team = [
  { name: 'Snehal Patel', role: 'Founder & Creative Director', img: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=400&q=80&auto=format&fit=crop&crop=face' },
  { name: 'Tushar Premal', role: 'Co-Founder & Tech Lead', img: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=400&q=80&auto=format&fit=crop&crop=face' },
  { name: 'Arbaz Shaikh', role: 'Head of Design', img: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&q=80&auto=format&fit=crop&crop=face' },
  { name: 'Aradhana Yadav', role: 'Digital Marketing Lead', img: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=400&q=80&auto=format&fit=crop&crop=face' },
  { name: 'Arjun Odedara', role: 'Full Stack Developer', img: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=400&q=80&auto=format&fit=crop&crop=face' },
];

const work = [
  { title: 'VivaBite Food App', category: 'App Development', img: 'https://images.unsplash.com/photo-1551650975-87deedd944c3?w=800&q=80&auto=format&fit=crop' },
  { title: 'Luxe Naturals Brand', category: 'Branding & Packaging', img: 'https://images.unsplash.com/photo-1611532736597-de2d4265fba3?w=800&q=80&auto=format&fit=crop' },
  { title: 'TechVault SaaS', category: 'Web Development', img: 'https://images.unsplash.com/photo-1467232004584-a241de8bcf5d?w=800&q=80&auto=format&fit=crop' },
  { title: 'GrowStar Campaign', category: 'Digital Marketing', img: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&q=80&auto=format&fit=crop' },
];

const testimonials = [
  { name: 'Ravi Mehta', role: 'CEO, NovaTech', text: '8dots transformed our brand identity from the ground up. The strategy was sharp, the design was stunning, and the results were immediate. Our investor pitches hit differently now.', img: 'https://images.unsplash.com/photo-1560250097-0b93528c311a?w=100&q=80&auto=format&fit=crop&crop=face' },
  { name: 'Priya Sharma', role: 'Founder, UrbanEats', text: 'The app they built for us has 4.9 stars on the Play Store after 1,200 reviews. That\'s not luck — that\'s meticulous design and engineering. We went from idea to launch in 16 weeks.', img: 'https://images.unsplash.com/photo-1580489944761-15a19d654956?w=100&q=80&auto=format&fit=crop&crop=face' },
  { name: 'Amit Joshi', role: 'CMO, FinServe India', text: 'Our organic traffic grew 340% in 6 months and our paid CAC dropped by half. 8dots doesn\'t just run campaigns — they build growth systems.', img: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=100&q=80&auto=format&fit=crop&crop=face' },
];

const marqueeItems = ['Branding', 'Web Design', 'App Dev', 'UI/UX', 'Digital Marketing', 'Software Dev', 'Graphic Design', 'Brand Strategy', 'Branding', 'Web Design', 'App Dev', 'UI/UX', 'Digital Marketing', 'Software Dev', 'Graphic Design', 'Brand Strategy'];
---

<Layout title="8dots — Creative Digital Agency | Ahmedabad" description="8dots is a full-service creative digital agency in Ahmedabad. Strategy, branding, web, app development, and digital marketing for brands that refuse to be ordinary.">
  <Navbar />

  <!-- ═══ HERO ═══ -->
  <section class="hero">
    <div class="hero-media">
      <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?w=1920&q=85&auto=format&fit=crop" alt="8dots agency workspace" loading="eager" />
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-container container">
      <div class="hero-left">
        <p class="eyebrow reveal">Creative Digital Agency · Ahmedabad, India</p>
        <h1 class="hero-h1 reveal reveal-delay-1">
          We Build<br>
          Things That<br>
          <span class="outline">Matter.</span>
        </h1>
        <p class="hero-sub reveal reveal-delay-2">Strategy, design, and technology —<br>crafted for brands that refuse to be ordinary.</p>
        <div class="hero-ctas reveal reveal-delay-3">
          <a href="#contact" class="btn-primary">Start a Project</a>
          <a href="#work" class="btn-ghost">See Our Work →</a>
        </div>
      </div>
      <div class="hero-stats reveal reveal-delay-2">
        <div class="stat"><span>13+</span><p>Years of Excellence</p></div>
        <div class="stat"><span>200+</span><p>Projects Delivered</p></div>
        <div class="stat"><span>50+</span><p>Happy Clients</p></div>
        <div class="stat"><span>7</span><p>Core Services</p></div>
      </div>
    </div>
    <div class="hero-scroll-line">
      <span>Scroll</span>
      <div class="scroll-bar"></div>
    </div>
  </section>

  <!-- ═══ MARQUEE ═══ -->
  <div class="marquee-band">
    <div class="marquee-track" aria-hidden="true">
      {marqueeItems.map(item => (
        <span class="marquee-item">{item}<em>✦</em></span>
      ))}
    </div>
  </div>

  <!-- ═══ SERVICES ═══ -->
  <section class="section" id="services">
    <div class="container">
      <div class="services-top reveal">
        <div class="section-head">
          <span class="eyebrow">What We Do</span>
          <h2>End-to-end digital<br>services for ambitious<br>brands.</h2>
        </div>
        <p class="services-desc">From the first sketch to the final pixel, we handle every dimension of your digital presence. Seven specialisms, one relentless team.</p>
      </div>
      <div class="services-grid">
        {services.map((s, i) => (
          <a href={`/services/${s.slug}`} class={`service-card reveal reveal-delay-${(i % 4) + 1}`}>
            <div class="card-img">
              <img src={s.img} alt={s.title} loading="lazy" />
            </div>
            <div class="card-body">
              <div class="card-top">
                <span class="card-icon">{s.icon}</span>
                <span class="card-num">0{i + 1}</span>
              </div>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
              <span class="card-link">Explore service →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ ABOUT BANNER ═══ -->
  <section class="about-banner">
    <div class="about-img-wrap">
      <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=1200&q=85&auto=format&fit=crop" alt="8dots team collaboration" loading="lazy" />
    </div>
    <div class="about-overlay">
      <div class="container">
        <div class="about-text reveal">
          <span class="eyebrow">About 8dots</span>
          <h2>We're a team of<br>makers, thinkers<br>& <span class="outline">builders.</span></h2>
          <p>Founded in Ahmedabad in 2012, we've spent 13+ years helping ambitious businesses grow through smart strategy and exceptional craft. We believe great work comes from deep collaboration, clear thinking, and a relentless pursuit of quality.</p>
          <a href="/#contact" class="btn-primary" style="margin-top: 2rem;">Work With Us</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ WORK ═══ -->
  <section class="section section-pure-white" id="work">
    <div class="container">
      <div class="work-top reveal">
        <div class="section-head">
          <span class="eyebrow" style="color:#777">Selected Work</span>
          <h2 style="color:#0a0a0a">Projects we're<br>proud of.</h2>
        </div>
        <a href="/#contact" class="btn-dark">Start Your Project</a>
      </div>
      <div class="work-grid">
        {work.map((w, i) => (
          <div class={`work-card reveal reveal-delay-${(i % 3) + 1}`}>
            <div class="work-img">
              <img src={w.img} alt={w.title} loading="lazy" />
              <div class="work-overlay">
                <span>View Project →</span>
              </div>
            </div>
            <div class="work-info">
              <span class="work-cat">{w.category}</span>
              <h3>{w.title}</h3>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ TEAM ═══ -->
  <section class="section" id="about">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">The Team</span>
        <h2>The people who<br>make it happen.</h2>
      </div>
      <div class="team-grid">
        {team.map((m, i) => (
          <div class={`team-card reveal reveal-delay-${(i % 4) + 1}`}>
            <div class="team-img">
              <img src={m.img} alt={m.name} loading="lazy" />
            </div>
            <h4>{m.name}</h4>
            <p>{m.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ TESTIMONIALS ═══ -->
  <section class="section section-white">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow" style="color:#777">Testimonials</span>
        <h2 style="color:#0a0a0a">What our clients say.</h2>
      </div>
      <div class="testi-grid">
        {testimonials.map((t, i) => (
          <div class={`testi-card reveal reveal-delay-${i + 1}`}>
            <p class="quote">&ldquo;{t.text}&rdquo;</p>
            <div class="testi-author">
              <img src={t.img} alt={t.name} loading="lazy" />
              <div>
                <strong>{t.name}</strong>
                <span>{t.role}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CTA BAND ═══ -->
  <section class="cta-band">
    <div class="container">
      <div class="cta-inner reveal">
        <div>
          <p class="eyebrow">Let's Build Something</p>
          <h2>Ready to make your<br>brand unforgettable?</h2>
        </div>
        <div class="cta-actions">
          <a href="#contact" class="btn-primary">Start a Project</a>
          <a href="tel:+917778882276" class="btn-ghost">+91 77788 82276</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ CONTACT ═══ -->
  <section class="section contact-section" id="contact">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-left reveal">
          <span class="eyebrow">Contact Us</span>
          <h2>Let's start<br>a conversation.</h2>
          <div class="contact-details">
            <div class="contact-item">
              <span>Email</span>
              <a href="mailto:info@8dots.in">info@8dots.in</a>
            </div>
            <div class="contact-item">
              <span>Phone</span>
              <a href="tel:+917778882276">+91 77788 82276</a>
            </div>
            <div class="contact-item">
              <span>Address</span>
              <address>516 STC, Bopal,<br>Ahmedabad, Gujarat 380058</address>
            </div>
            <div class="contact-item">
              <span>Also</span>
              <address>Houston, TX, USA</address>
            </div>
          </div>
          <div class="contact-socials">
            <a href="https://linkedin.com/company/8dots" aria-label="LinkedIn" target="_blank" rel="noopener">in</a>
            <a href="https://instagram.com/8dots.in" aria-label="Instagram" target="_blank" rel="noopener">ig</a>
            <a href="https://facebook.com/8dots.in" aria-label="Facebook" target="_blank" rel="noopener">fb</a>
          </div>
        </div>
        <form class="contact-form reveal reveal-delay-2" name="contact" method="POST" data-netlify="true">
          <input type="hidden" name="form-name" value="contact" />
          <div class="form-row">
            <div class="form-field">
              <label>Your Name</label>
              <input type="text" name="name" placeholder="John Doe" required />
            </div>
            <div class="form-field">
              <label>Email Address</label>
              <input type="email" name="email" placeholder="john@company.com" required />
            </div>
          </div>
          <div class="form-field">
            <label>Service Needed</label>
            <select name="service">
              <option value="">Select a service</option>
              <option>Branding</option>
              <option>Web Development</option>
              <option>App Development</option>
              <option>UI/UX Design</option>
              <option>Digital Marketing</option>
              <option>Graphic Design</option>
              <option>Software Development</option>
              <option>Multiple Services</option>
            </select>
          </div>
          <div class="form-field">
            <label>Tell us about your project</label>
            <textarea name="message" rows="5" placeholder="What are you building? What's your timeline and budget?" required></textarea>
          </div>
          <button type="submit" class="btn-primary" style="width:100%;justify-content:center">Send Message</button>
        </form>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
/* ─── HERO ─── */
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: stretch;
}
.hero-media {
  position: absolute;
  inset: 0;
}
.hero-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: grayscale(30%);
}
.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    135deg,
    rgba(10,10,10,0.92) 0%,
    rgba(10,10,10,0.75) 50%,
    rgba(10,10,10,0.55) 100%
  );
}
.hero-container {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 3rem;
  padding-top: 100px;
  padding-bottom: clamp(3rem, 8vw, 6rem);
  width: 100%;
}
.hero-left { flex: 1; max-width: 700px; }
.hero-h1 {
  font-family: 'Syne', sans-serif;
  font-size: clamp(3rem, 8vw, 7rem);
  font-weight: 800;
  line-height: 0.95;
  letter-spacing: -0.03em;
  margin: 1.5rem 0 1.5rem;
  color: #f8f8f6;
}
.hero-sub {
  font-size: clamp(1rem, 1.5vw, 1.2rem);
  color: rgba(248,248,246,0.65);
  line-height: 1.6;
  margin-bottom: 2.5rem;
}
.hero-ctas { display: flex; gap: 1rem; flex-wrap: wrap; }
.hero-stats {
  display: flex;
  flex-direction: column;
  gap: 2rem;
  flex-shrink: 0;
  border-left: 1px solid rgba(255,255,255,0.15);
  padding-left: 3rem;
}
.stat span {
  display: block;
  font-family: 'Syne', sans-serif;
  font-size: clamp(2rem, 3.5vw, 3rem);
  font-weight: 800;
  color: #f8f8f6;
  line-height: 1;
}
.stat p {
  font-size: 0.8rem;
  color: rgba(248,248,246,0.5);
  margin-top: 0.25rem;
}
.hero-scroll-line {
  position: absolute;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  z-index: 2;
}
.hero-scroll-line span {
  font-size: 0.65rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgba(248,248,246,0.4);
}
.scroll-bar {
  width: 1px;
  height: 48px;
  background: linear-gradient(to bottom, rgba(248,248,246,0.4), transparent);
  animation: scrollPulse 2s ease-in-out infinite;
}
@keyframes scrollPulse { 0%,100%{opacity:0.4} 50%{opacity:1} }

/* ─── MARQUEE ─── */
.marquee-band {
  background: #f8f8f6;
  overflow: hidden;
  padding: 1rem 0;
  border-top: 1px solid rgba(0,0,0,0.08);
  border-bottom: 1px solid rgba(0,0,0,0.08);
}
.marquee-item {
  display: inline-flex;
  align-items: center;
  gap: 1.5rem;
  font-family: 'Syne', sans-serif;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #0a0a0a;
  padding-right: 3rem;
}
.marquee-item em { font-style: normal; color: #aaa; font-size: 0.5rem; }

/* ─── SERVICES ─── */
.services-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 3rem;
  margin-bottom: clamp(2.5rem, 6vw, 4rem);
}
.services-top .section-head { flex: 1; }
.services-desc {
  flex: 0 0 380px;
  color: rgba(248,248,246,0.55);
  font-size: 1.05rem;
  line-height: 1.75;
  padding-top: 0.5rem;
}
.services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.5px;
  background: rgba(255,255,255,0.06);
}
.service-card {
  background: var(--dark-card);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: background 0.3s;
}
.service-card:hover { background: #161616; }
.card-img {
  height: 200px;
  overflow: hidden;
}
.card-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: grayscale(40%);
  transition: transform 0.6s var(--ease), filter 0.4s;
}
.service-card:hover .card-img img { transform: scale(1.06); filter: grayscale(0%); }
.card-body {
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  flex: 1;
}
.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.75rem;
}
.card-icon { font-size: 1.4rem; }
.card-num {
  font-size: 0.7rem;
  font-weight: 700;
  color: rgba(248,248,246,0.2);
  letter-spacing: 0.1em;
}
.card-body h3 {
  font-family: 'Syne', sans-serif;
  font-size: 1.2rem;
  font-weight: 700;
  margin-bottom: 0.6rem;
}
.card-body p {
  font-size: 0.875rem;
  color: rgba(248,248,246,0.55);
  line-height: 1.65;
  flex: 1;
}
.card-link {
  display: inline-block;
  margin-top: 1.25rem;
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  color: rgba(248,248,246,0.4);
  transition: color 0.2s;
}
.service-card:hover .card-link { color: #f8f8f6; }

/* ─── ABOUT BANNER ─── */
.about-banner {
  position: relative;
  min-height: 600px;
  display: flex;
  align-items: center;
}
.about-img-wrap {
  position: absolute;
  inset: 0;
}
.about-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: grayscale(20%);
}
.about-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to right, rgba(10,10,10,0.96) 45%, rgba(10,10,10,0.4) 100%);
  display: flex;
  align-items: center;
}
.about-text {
  max-width: 600px;
  padding: clamp(3rem, 8vw, 6rem) 0;
}
.about-text h2 {
  font-family: 'Syne', sans-serif;
  font-size: clamp(2rem, 4.5vw, 4rem);
  font-weight: 800;
  line-height: 1.05;
  margin: 1rem 0 1.5rem;
}
.about-text p {
  font-size: 1.05rem;
  color: rgba(248,248,246,0.6);
  line-height: 1.75;
  max-width: 480px;
}

/* ─── WORK ─── */
.work-top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 2rem;
  margin-bottom: clamp(2rem, 5vw, 3.5rem);
}
.work-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
}
.work-card { cursor: pointer; }
.work-img {
  position: relative;
  overflow: hidden;
  aspect-ratio: 4/3;
  background: #e8e4df;
}
.work-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s var(--ease);
}
.work-overlay {
  position: absolute;
  inset: 0;
  background: rgba(10,10,10,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s;
}
.work-overlay span {
  color: #f8f8f6;
  font-weight: 700;
  font-size: 1rem;
  letter-spacing: 0.05em;
}
.work-card:hover .work-img img { transform: scale(1.04); }
.work-card:hover .work-overlay { opacity: 1; }
.work-info { padding: 1rem 0 0; }
.work-cat {
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #888;
}
.work-info h3 {
  font-family: 'Syne', sans-serif;
  font-size: 1.1rem;
  font-weight: 700;
  color: #0a0a0a;
