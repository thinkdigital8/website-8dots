  features={[
    { title: 'UX Research & Discovery', desc: 'User interviews, surveys, competitive analysis, and persona development.' },
    { title: 'Information Architecture', desc: 'Sitemaps, user flow diagrams, and content hierarchies that make navigation intuitive.' },
    { title: 'Wireframing & Prototyping', desc: 'Low-fi to high-fi prototypes in Figma, validated with real users.' },
    { title: 'UI Design (Web & Mobile)', desc: 'Pixel-perfect visual design systems built for consistency and scalability.' },
    { title: 'Design Systems', desc: 'Component libraries, style guides, and token sets for engineering teams.' },
    { title: 'Usability Testing', desc: 'Moderated sessions, heatmap analysis, and session recordings to validate decisions.' },
    { title: 'Interaction Design', desc: 'Micro-animations, transitions, and motion design that delight users.' },
    { title: 'Handoff & Dev Support', desc: 'Developer-ready Figma files with specs, assets, and annotation.' },
  ]}
