---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
---
<ServiceLayout
  title="UI/UX Design"
  description="User interface and experience design by 8dots — research-driven, visually stunning interfaces that convert and delight."
  slug="ui-ux-design"
  icon="🎨"
  image="https://images.unsplash.com/photo-1561070791-2526d30994b5?w=1600&q=85&auto=format&fit=crop"
  tagline="Design That Feels Right. Performs Better."
  heroDesc="Great design is invisible — it just works. We create interfaces grounded in user research and brought to life with pixel-perfect craft. Every screen is intentional. Every interaction is earned."
  features={[
    { title: 'User Research', desc: 'Interviews, surveys, and usability studies that reveal what your users actually need.' },
    { title: 'Information Architecture', desc: 'Sitemaps, user flows, and content hierarchy that make navigation instinctive.' },
    { title: 'Wireframing', desc: 'Low and mid-fidelity wireframes that validate structure before visual design begins.' },
    { title: 'UI Design', desc: 'High-fidelity Figma designs with your design system, typography, and colour applied.' },
    { title: 'Prototyping', desc: 'Interactive Figma prototypes for usability testing and stakeholder sign-off.' },
    { title: 'Design Systems', desc: 'Scalable component libraries in Figma that keep product teams consistent.' },
    { title: 'Usability Testing', desc: 'Moderated and unmoderated testing with real users to validate design decisions.' },
    { title: 'Design Handoff', desc: 'Developer-ready specs, assets, and annotation in Figma for smooth handoff.' },
  ]}
  process={[
    { step: '01', title: 'Research & Discovery', desc: 'Understand user goals, pain points, and the competitive landscape.' },
    { step: '02', title: 'Define & Architect', desc: 'Map user journeys, define information architecture, and align on scope.' },
    { step: '03', title: 'Wireframe & Prototype', desc: 'Build low-fidelity wireframes and test assumptions early.' },
    { step: '04', title: 'Visual Design', desc: 'Apply brand, typography, and colour to create stunning, final-fidelity screens.' },
    { step: '05', title: 'Test & Handoff', desc: 'Validate with users, iterate, and hand off polished specs to developers.' },
  ]}
  faqs={[
    { q: 'What tools do you design in?', a: 'Figma is our primary tool for UI/UX. We also use FigJam for workshops, and Maze or Lookback for usability testing.' },
    { q: 'Do you also code the designs?', a: 'Yes. We offer full-service engagements where our designers work directly with our developers to implement the designs precisely.' },
    { q: 'Can you improve my existing product\'s UX?', a: 'Absolutely. We do UX audits to identify friction points, then redesign specific flows or the whole product depending on scope.' },
  ]}
  related={[
    { slug: 'web-development', label: 'Web Development', icon: '🌐' },
    { slug: 'app-development', label: 'App Development', icon: '📱' },
    { slug: 'graphic-design', label: 'Graphic Design', icon: '✏️' },
  ]}
/>
