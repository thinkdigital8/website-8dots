---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
---
<ServiceLayout
  title="App Development"
  description="iOS, Android & cross-platform app development by 8dots. From concept to launch — powerful, scalable mobile apps for startups and enterprises."
  slug="app-development"
  icon="📱"
  tagline="Apps That Move People — and Business."
  heroDesc="We build iOS, Android and cross-platform mobile applications that deliver exceptional user experiences and drive measurable business outcomes. From MVP to enterprise-grade products."
  features={[
    { title: 'iOS App Development', desc: 'Native Swift apps optimised for performance, privacy, and App Store success.' },
    { title: 'Android App Development', desc: 'Kotlin-based Android apps built for the full spectrum of devices.' },
    { title: 'React Native / Flutter', desc: 'Cross-platform apps with near-native performance from a single codebase.' },
    { title: 'App UI/UX Design', desc: 'User-centric design flows that retain users and boost engagement.' },
    { title: 'API & Backend Integration', desc: 'RESTful APIs, GraphQL, Firebase and third-party service integrations.' },
    { title: 'App Store Optimisation', desc: 'ASO strategy to maximise downloads from day one.' },
    { title: 'QA & Testing', desc: 'Device-level testing, crash analytics and performance benchmarking.' },
    { title: 'Post-Launch Support', desc: 'Ongoing maintenance, updates, and feature sprints after launch.' },
  ]}
  process={[
    { step: '01', title: 'Discovery & Scoping', desc: 'We map your audience, define core features, and lock the MVP scope.' },
    { step: '02', title: 'UI/UX Prototyping', desc: 'Clickable Figma prototypes validated with real users before a line of code is written.' },
    { step: '03', title: 'Agile Development', desc: 'Two-week sprints with working builds delivered to your device every iteration.' },
    { step: '04', title: 'Testing & QA', desc: 'Manual and automated testing across devices, OS versions and edge cases.' },
    { step: '05', title: 'Launch & Growth', desc: 'App store submission, ASO, and post-launch analytics to guide growth.' },
  ]}
  faqs={[
    { q: 'How long does it take to build an app?', a: 'A typical MVP takes 8–16 weeks. Complex apps with multiple integrations may take 5–9 months. We set clear milestones from day one.' },
    { q: 'Do you build for both iOS and Android?', a: 'Yes. We build native apps for both platforms, or cross-platform apps using React Native or Flutter depending on your needs and budget.' },
    { q: 'Can I see progress during development?', a: 'Absolutely. You get working builds every sprint (every 2 weeks) and access to a shared project board throughout the project.' },
  ]}
  related={[
    { slug: 'ui-ux-design', label: 'UI/UX Design', icon: '🎨' },
    { slug: 'web-development', label: 'Web Development', icon: '🌐' },
    { slug: 'software-development', label: 'Software Development', icon: '⚙️' },
  ]}
/>
