---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
---
<ServiceLayout
  title="App Development"
  description="iOS and Android app development by 8dots — from MVP to full-scale mobile products that users love."
  slug="app-development"
  icon="📱"
  image="https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?w=1600&q=85&auto=format&fit=crop"
  tagline="Apps Users Love. Revenue You'll Notice."
  heroDesc="From your first sketch to the App Store listing, we design and engineer mobile apps that are beautiful, fast, and built to grow. iOS, Android, or both — we've shipped over 40 apps."
  features={[
    { title: 'iOS Development', desc: 'Native Swift apps built for iPhone and iPad with App Store submission support.' },
    { title: 'Android Development', desc: 'Kotlin-powered native Android apps optimised for the full device ecosystem.' },
    { title: 'React Native / Flutter', desc: 'Cross-platform apps that share a codebase without sacrificing performance or look.' },
    { title: 'UI/UX for Mobile', desc: 'Mobile-first design with gesture-driven interfaces and platform HIG compliance.' },
    { title: 'Backend & API', desc: 'Node.js, Firebase, and AWS-backed APIs that power your app reliably at scale.' },
    { title: 'App Store Optimisation', desc: 'ASO strategy — keywords, screenshots, descriptions — to maximise discoverability.' },
    { title: 'Push Notifications', desc: 'Engagement-driving notification systems with segmentation and A/B testing.' },
    { title: 'Analytics & Crash Reporting', desc: 'Firebase, Mixpanel, and Sentry integration for data-driven improvement.' },
  ]}
  process={[
    { step: '01', title: 'Product Discovery', desc: 'Define user personas, core flows, and feature scope for an MVP that ships fast.' },
    { step: '02', title: 'UX Design', desc: 'Wireframes, prototypes, and usability testing before a line of code is written.' },
    { step: '03', title: 'Development Sprints', desc: 'Two-week agile sprints with working builds delivered throughout.' },
    { step: '04', title: 'QA & Beta Testing', desc: 'Automated tests, manual QA, and TestFlight / Play Console beta programs.' },
    { step: '05', title: 'Launch & Scale', desc: 'App Store submission, launch strategy, and post-launch performance monitoring.' },
  ]}
  faqs={[
    { q: 'Should I build native or cross-platform?', a: 'If you need one platform fast and cost-efficiently, cross-platform (React Native / Flutter) is great. For high-performance apps with deep hardware access, native is better. We\'ll guide you to the right call.' },
    { q: 'How long does app development take?', a: 'A focused MVP typically takes 10–16 weeks. Full-featured apps can take 6–12 months depending on complexity.' },
    { q: 'Do you offer post-launch support?', a: 'Yes. We offer retainer-based support covering bug fixes, OS updates, feature additions, and performance monitoring.' },
  ]}
  related={[
    { slug: 'ui-ux-design', label: 'UI/UX Design', icon: '🎨' },
    { slug: 'software-development', label: 'Software Dev', icon: '⚙️' },
    { slug: 'web-development', label: 'Web Development', icon: '🌐' },
  ]}
/>
