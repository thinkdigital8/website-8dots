---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
---
<ServiceLayout
  title="Web Development"
  description="Custom websites, web apps, e-commerce platforms and CMS solutions by 8dots. Built for speed, SEO, and conversions."
  slug="web-development"
  icon="🌐"
  tagline="Websites That Work as Hard as You Do."
  heroDesc="From landing pages to full-stack web applications, we engineer digital experiences that perform, scale, and convert visitors into customers."
  features={[
    { title: 'Custom Web Applications', desc: 'Bespoke full-stack web apps built on React, Next.js, or other modern frameworks.' },
    { title: 'E-Commerce Development', desc: 'Shopify, WooCommerce, and custom e-commerce platforms with seamless checkout.' },
    { title: 'CMS Solutions', desc: 'WordPress, Strapi, Sanity and headless CMS setups for easy content management.' },
    { title: 'Landing Page Design', desc: 'High-converting landing pages built for campaigns and lead generation.' },
    { title: 'API Development', desc: 'RESTful and GraphQL APIs, microservices and third-party integrations.' },
    { title: 'Performance Optimisation', desc: 'Core Web Vitals, speed audits, CDN setup and caching strategies.' },
    { title: 'SEO-Ready Architecture', desc: 'Technical SEO baked in — sitemaps, schema, canonical URLs, structured data.' },
    { title: 'Maintenance & Support', desc: 'Ongoing hosting, backups, updates, and feature development after launch.' },
  ]}
  process={[
    { step: '01', title: 'Strategy & Wireframes', desc: 'Define goals, user journeys, and page architecture before design begins.' },
    { step: '02', title: 'UI Design & Prototyping', desc: 'Pixel-perfect designs with interactive prototypes for stakeholder sign-off.' },
    { step: '03', title: 'Development & Build', desc: 'Clean, semantic, accessible code built for speed and maintainability.' },
    { step: '04', title: 'QA & Cross-Browser Testing', desc: 'Tested on all major browsers, devices, and screen sizes.' },
    { step: '05', title: 'Launch & Handover', desc: 'Smooth deployment, CMS training, and full documentation delivered.' },
  ]}
  faqs={[
    { q: 'How much does a website cost?', a: 'A professional business website starts from ₹50,000. E-commerce and web apps are priced based on scope. We offer free discovery calls to give accurate estimates.' },
    { q: 'Do you provide hosting?', a: 'Yes. We offer managed hosting on fast, secure infrastructure, or we can deploy on your preferred cloud provider.' },
    { q: 'Will my website rank on Google?', a: 'We build all sites with SEO best practices from day one. For ongoing SEO growth, our digital marketing team can run a dedicated campaign.' },
  ]}
  related={[
    { slug: 'digital-marketing', label: 'Digital Marketing', icon: '📈' },
    { slug: 'ui-ux-design', label: 'UI/UX Design', icon: '🎨' },
    { slug: 'app-development', label: 'App Development', icon: '📱' },
  ]}
/>
